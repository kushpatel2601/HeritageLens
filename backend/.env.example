# HeritageLens API settings. Copy to `backend/.env` (read from the directory you start the API in) or set them as
# environment variables. Every setting is optional: the defaults below run the whole stack locally on SQLite.

# --- General -------------------------------------------------------------------------------------------------------
# HL_ENV=dev                      # dev | test | prod
# HL_LOG_LEVEL=INFO
# HL_LOG_JSON=false               # one JSON object per log line

# --- Database ------------------------------------------------------------------------------------------------------
# Default: SQLite at backend/var/heritagelens.db, schema created on start-up.
# HL_DATABASE_URL=sqlite+aiosqlite:///./var/heritagelens.db
# PostgreSQL + pgvector (run `python -m app.cli migrate` first, and turn auto-create off):
# HL_DATABASE_URL=postgresql+asyncpg://heritage:heritage@localhost:5432/heritagelens
# HL_AUTO_CREATE_SCHEMA=false

# --- File storage --------------------------------------------------------------------------------------------------
# HL_STORAGE_BACKEND=local        # local | s3
# HL_STORAGE_DIR=./var/storage
# S3 or MinIO (needs the `s3` extra: pip install -e ".[s3]"):
# HL_S3_BUCKET=heritagelens
# HL_S3_ENDPOINT_URL=http://localhost:9000
# HL_S3_REGION=us-east-1
# HL_S3_ACCESS_KEY=
# HL_S3_SECRET_KEY=

# --- Security ------------------------------------------------------------------------------------------------------
# Browser origins allowed to call the API directly (the Next.js app proxies /api, so it rarely needs this).
# HL_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Shared secret for GPU workers (Colab). CHANGE THIS before exposing the API through a tunnel.
HL_WORKER_TOKEN=dev-worker-token
# When set, uploads and reprocessing require `Authorization: Bearer <token>`.
# HL_INGEST_TOKEN=
# HL_MAX_UPLOAD_MB=200
# HL_MAX_PDF_PAGES=400

# --- Search and embeddings -----------------------------------------------------------------------------------------
# auto = fastembed if installed (pip install -e ".[ml]"), otherwise a deterministic hashing embedder.
# HL_EMBEDDER=auto                # auto | fastembed | hashing
# HL_ENABLE_IMAGE_SEARCH=true     # CLIP text-to-photo search (fastembed only)
# HL_SEMANTIC_MIN_SCORE=0.3
# HL_CLIP_MIN_SCORE=0.24
# HL_CHUNK_CHARS=480
# HL_CHUNK_OVERLAP=80

# --- Jobs and workers ----------------------------------------------------------------------------------------------
# HL_EMBEDDED_WORKER=true         # run a CPU worker inside the API process
# HL_EMBEDDED_WORKER_CONCURRENCY=2
# HL_JOB_LEASE_SECONDS=300
# HL_JOB_MAX_ATTEMPTS=3
# HL_GPU_JOBS=ocr,translate,caption,reconstruct3d
# HL_GPU_FALLBACK_TO_CPU=true     # run OCR on the CPU queue when local Tesseract is installed
# HL_ENABLE_CAPTIONS=true
# HL_WORKER_OFFLINE_AFTER_SECONDS=60

# HeritageLens web app settings. Copy to `frontend/.env.local`, or set them in the shell before `npm run dev` or
# `npm run build`. They are read at build time.

# Where the FastAPI server listens. The app proxies `/api/*` there, so the browser never calls it directly.
API_ORIGIN=http://127.0.0.1:8000

# Optional: MapLibre style for the atlas (default: OpenFreeMap Positron, no key needed).
# NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/positron

# Optional: "Open in Colab" link shown on /archive/pipeline for the GPU worker notebook.
# NEXT_PUBLIC_COLAB_URL=https://colab.research.google.com/github/kushpatel2601/HeritageLens/blob/main/notebooks/heritage_gpu_worker.ipynb
